# Production viewer image: no Admin source or assets in any stage.
FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS public-builder
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY design-system/ /design-system/
COPY frontend/ ./
ENV VITE_API_BASE_URL=/api/v1
RUN npm run build

FROM nginx:alpine@sha256:72ba65eb42c10344912a84ff42408db7d34f2feb642204570ab8fc5ffd29f1d3 AS public-runtime
ARG GIT_COMMIT_SHA
LABEL org.opencontainers.image.revision=${GIT_COMMIT_SHA}
LABEL io.kinosota.role=public-frontend
RUN rm -rf /usr/share/nginx/html/*
COPY nginx.public-only.conf /etc/nginx/conf.d/default.conf
COPY --from=public-builder /app/dist /usr/share/nginx/html/public
# Static assets must stay readable even when the Git archive was staged with umask 077.
RUN chmod 0755 /etc/nginx/conf.d /usr/share/nginx/html \
 && chmod 0644 /etc/nginx/conf.d/default.conf \
 && find /usr/share/nginx/html/public -type d -exec chmod 0755 {} + \
 && find /usr/share/nginx/html/public -type f -exec chmod 0644 {} +
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
