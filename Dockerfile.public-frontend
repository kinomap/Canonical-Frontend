# Production viewer image: no Admin source or assets in any stage.
FROM node:20-alpine AS public-builder
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_API_BASE_URL=/api/v1
RUN npm run build

FROM nginx:alpine AS public-runtime
ARG GIT_COMMIT_SHA
LABEL org.opencontainers.image.revision=${GIT_COMMIT_SHA}
LABEL io.kinosota.role=public-frontend
RUN rm -rf /usr/share/nginx/html/*
COPY nginx.public-only.conf /etc/nginx/conf.d/default.conf
COPY --from=public-builder /app/dist /usr/share/nginx/html/public
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
