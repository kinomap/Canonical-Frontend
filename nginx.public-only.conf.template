# Only allow a catalog slug; never interpolate an arbitrary filesystem path.
map $arg_genre $genre_snapshot {
    default /__no_genre_snapshot__;
    ~^[a-z0-9-]+$ /seo-genres/$arg_genre.html;
}
upstream control_pool {
    server __BACKEND_WG_ADDRESS__:8888;
    keepalive 32;
}

# Public-only showcase. Validated exact placeholders; no global envsubst.
log_format public_no_query '$remote_addr $request_method $uri $status';
server {
    listen 80;
    server_name __PUBLIC_HOST__;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location = /admin { return 301 https://__PUBLIC_HOST__$request_uri; }
    location /api/ {
        proxy_pass http://control_pool;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    # ZERO MEDIA ON VPS1/VPS2: media bytes go client -> https://<node>/ only; this edge never relays or caches them.
    location ^~ /media/cinema-intro/ { return 404; }
    location ~* ^/media/.+\.(?:mp4|webm|m4v|mkv|mov|avi|ts|m3u8|mpd|mp3|aac|m4a|ogg|oga|opus|flac|wav)$ { return 404; }
    location /media/ {
        proxy_pass http://control_pool;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Range $http_range;
        proxy_set_header X-Forwarded-For $remote_addr;
        # v15: posters/backdrops (100-600 KB) fit the buffers instead of spilling to proxy_temp files.
        proxy_buffer_size 128k;
        proxy_buffers 16 128k;
        proxy_busy_buffers_size 256k;
    }
    # The prestart intro is served by the Media Nodes only (https://<node>/intro/...).
    location ^~ /cinema/intro/ { return 404; }
    location ^~ /cinema/ {
        root /usr/share/nginx/html/public;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
    }
    location = /stream { return 404; }
    location ^~ /stream/ { return 404; }
    location ^~ /assets/ { root /usr/share/nginx/html/public; try_files $uri =404; add_header Cache-Control "public, max-age=31536000, immutable"; add_header X-Content-Type-Options nosniff always; }
    # Lite TV portal for 2012-2017 Smart TVs (static ES5 page, never the SPA fallback).
    location = /tv/lite { root /usr/share/nginx/html/public; try_files /tv/lite/index.html =404; add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options nosniff always; add_header Referrer-Policy strict-origin-when-cross-origin always; }
    location = /tv/lite/ { root /usr/share/nginx/html/public; try_files /tv/lite/index.html =404; add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options nosniff always; add_header Referrer-Policy strict-origin-when-cross-origin always; }
    location / { root /usr/share/nginx/html/public; try_files $uri /index.html; add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options nosniff always; add_header Referrer-Policy strict-origin-when-cross-origin always; }
}
server {
    listen 443 ssl;
    server_name __PUBLIC_HOST__;
    ssl_certificate /etc/kinosota-tls/fullchain.pem;
    ssl_certificate_key /etc/kinosota-tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    access_log /var/log/nginx/access.log public_no_query;
    absolute_redirect off;
    client_max_body_size 3m;
    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_min_length 512;
    gzip_types application/json application/javascript text/css image/svg+xml;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    # SEO pre-rendered content pages: try SEO volume first, then built SPA, then SPA fallback.
    location = /movies { root /usr/share/nginx/html; try_files /seo/movies/index.html /public/movies/index.html /public/index.html; add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options nosniff always; add_header Referrer-Policy strict-origin-when-cross-origin always; }
    location = /series { root /usr/share/nginx/html; try_files /seo/series/index.html /public/series/index.html /public/index.html; add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options nosniff always; add_header Referrer-Policy strict-origin-when-cross-origin always; }
    location ~ "^/(movies|series)/[0-9a-f-]{36}(/[a-z0-9-]+)?$" { root /usr/share/nginx/html; try_files /seo$uri/index.html /public$uri/index.html /public/index.html; add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options nosniff always; add_header Referrer-Policy strict-origin-when-cross-origin always; }
    location = /genres { root /usr/share/nginx/html; try_files /seo$genre_snapshot /seo/genres/index.html /public/genres/index.html /public/index.html; add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options nosniff always; add_header Referrer-Policy strict-origin-when-cross-origin always; }
    location ^~ /posters/v1/ { root /usr/share/nginx/html/public; try_files $uri =404; add_header Cache-Control "public, max-age=31536000, immutable"; add_header X-Content-Type-Options nosniff always; }
    # The prestart intro is served by the Media Nodes only (https://<node>/intro/...).
    location ^~ /cinema/intro/ { return 404; }
    location ^~ /cinema/ {
        root /usr/share/nginx/html/public;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
    }
    location ~* \.(?:woff2?|ttf|otf)$ {
        root /usr/share/nginx/html/public;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
    }
    location = /robots.txt { root /usr/share/nginx/html; try_files /seo/robots.txt /public/robots.txt =404; }
    location = /sitemap.xml { root /usr/share/nginx/html; try_files /seo/sitemap.xml /public/sitemap.xml =404; }
    location = /healthz { access_log off; return 200 'ok'; }
    location = /admin { return 403; }
    location ^~ /admin/ { return 403; }
    location = /api/v1/admin { return 403; }
    location ^~ /api/v1/admin/ { return 403; }
    location = /api/v1/internal { return 403; }
    location ^~ /api/v1/internal/ { return 403; }
    # VPS1 additionally applies its method/path allowlist to the WG source .3.
    location /api/ {
        proxy_pass http://control_pool;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    # ZERO MEDIA ON VPS1/VPS2: media bytes go client -> https://<node>/ only; this edge never relays or caches them.
    location ^~ /media/cinema-intro/ { return 404; }
    location ~* ^/media/.+\.(?:mp4|webm|m4v|mkv|mov|avi|ts|m3u8|mpd|mp3|aac|m4a|ogg|oga|opus|flac|wav)$ { return 404; }
    location /media/ {
        proxy_pass http://control_pool;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Range $http_range;
        proxy_set_header X-Forwarded-For $remote_addr;
        # v15: posters/backdrops (100-600 KB) fit the buffers instead of spilling to proxy_temp files.
        proxy_buffer_size 128k;
        proxy_buffers 16 128k;
        proxy_busy_buffers_size 256k;
    }
    location = /stream { return 404; }
    location ^~ /stream/ { return 404; }
    location ^~ /assets/ { root /usr/share/nginx/html/public; try_files $uri =404; add_header Cache-Control "public, max-age=31536000, immutable"; add_header X-Content-Type-Options nosniff always; }
    location = /index.html { root /usr/share/nginx/html; try_files /seo/index.html /public/index.html =404; add_header Cache-Control "no-cache"; add_header X-Content-Type-Options nosniff always; add_header Referrer-Policy strict-origin-when-cross-origin always; }
    # Lite TV portal for 2012-2017 Smart TVs (static ES5 page, never the SPA fallback).
    location = /tv/lite { root /usr/share/nginx/html/public; try_files /tv/lite/index.html =404; add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options nosniff always; add_header Referrer-Policy strict-origin-when-cross-origin always; }
    location = /tv/lite/ { root /usr/share/nginx/html/public; try_files /tv/lite/index.html =404; add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options nosniff always; add_header Referrer-Policy strict-origin-when-cross-origin always; }
    location / { root /usr/share/nginx/html/public; try_files $uri /index.html; add_header Cache-Control "no-cache" always; add_header X-Content-Type-Options nosniff always; add_header Referrer-Policy strict-origin-when-cross-origin always; }
}
