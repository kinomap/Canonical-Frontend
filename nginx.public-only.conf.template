# Only allow a catalog slug; never interpolate an arbitrary filesystem path.
map $arg_genre $genre_snapshot {
    default /__no_genre_snapshot__;
    ~^[a-z0-9-]+$ /seo-genres/$arg_genre.html;
}
upstream control_pool {
    server __BACKEND_WG_ADDRESS__:8888;
    keepalive 32;
}
# Public-only showcase. Validated exact placeholders; no global envsubst.
log_format public_no_query '$remote_addr $request_method $uri $status';
server {
    listen 80;
    server_name __PUBLIC_HOST__;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://__PUBLIC_HOST__$request_uri; }
}
server {
    listen 443 ssl;
    server_name __PUBLIC_HOST__;
    ssl_certificate /etc/kinosota-tls/fullchain.pem;
    ssl_certificate_key /etc/kinosota-tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    access_log /var/log/nginx/access.log public_no_query;
    absolute_redirect off;
    client_max_body_size 3m;
    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_min_length 512;
    gzip_types application/json application/javascript text/css image/svg+xml;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    location = /movies { root /usr/share/nginx/html/public; try_files /movies/index.html /index.html; }
    location = /series { root /usr/share/nginx/html/public; try_files /series/index.html /index.html; }
    location ~ "^/(movies|series)/[0-9a-f-]{36}(/[a-z0-9-]+)?$" { root /usr/share/nginx/html/public; try_files $uri/index.html /index.html; }
    location = /genres { root /usr/share/nginx/html/public; try_files $genre_snapshot /genres/index.html /index.html; }
    location ^~ /posters/v1/ { root /usr/share/nginx/html/public; try_files $uri =404; add_header Cache-Control "public, max-age=31536000, immutable"; add_header X-Content-Type-Options nosniff always; }
    location ^~ /cinema/v1/ {
        root /usr/share/nginx/html/public;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
    }
    location ~* \.(?:woff2?|ttf|otf)$ {
        root /usr/share/nginx/html/public;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
    }
    location = /robots.txt { root /usr/share/nginx/html/public; try_files $uri =404; }
    location = /sitemap.xml { root /usr/share/nginx/html/public; try_files $uri =404; }
    location = /healthz { access_log off; return 200 'ok'; }
    location = /admin { return 403; }
    location ^~ /admin/ { return 403; }
    location = /api/v1/admin { return 403; }
    location ^~ /api/v1/admin/ { return 403; }
    location = /api/v1/internal { return 403; }
    location ^~ /api/v1/internal/ { return 403; }
    # VPS1 additionally applies its method/path allowlist to the WG source .3.
    location /api/ { proxy_pass http://control_pool; }
    location /media/ { proxy_pass http://control_pool; }
    location = /stream { return 404; }
    location ^~ /stream/ { return 404; }
    location ^~ /assets/ { root /usr/share/nginx/html/public; try_files $uri =404; add_header Cache-Control "public, max-age=31536000, immutable"; add_header X-Content-Type-Options nosniff always; }
    location = /index.html { root /usr/share/nginx/html/public; add_header Cache-Control "no-cache"; add_header X-Content-Type-Options nosniff always; add_header Referrer-Policy strict-origin-when-cross-origin always; }
    location / { root /usr/share/nginx/html/public; try_files $uri /index.html; }
}
