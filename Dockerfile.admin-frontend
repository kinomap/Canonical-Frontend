# Private Admin assets; expose only through the Backend's WG gateway.
FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS admin-builder
ARG VITE_ADMIN_BASE_PATH=/admin/
ENV VITE_ADMIN_BASE_PATH=${VITE_ADMIN_BASE_PATH}
WORKDIR /app
COPY admin-frontend/package.json admin-frontend/package-lock.json ./
RUN npm ci
COPY design-system/ /design-system/
COPY admin-frontend/ ./
RUN npm run build

FROM nginx:alpine@sha256:72ba65eb42c10344912a84ff42408db7d34f2feb642204570ab8fc5ffd29f1d3 AS admin-runtime
ARG GIT_COMMIT_SHA
LABEL org.opencontainers.image.revision=${GIT_COMMIT_SHA}
LABEL io.kinosota.role=private-admin
RUN rm -rf /usr/share/nginx/html/*
COPY nginx.admin-only.conf /etc/nginx/conf.d/default.conf
COPY --from=admin-builder /app/dist /usr/share/nginx/html/admin
# SSH bootstrap uses a restrictive umask. COPY preserves those source modes;
# public config/assets must remain readable by the non-root runtime (101:101).
RUN chmod 0755 /etc/nginx/conf.d /usr/share/nginx/html \
 && chmod 0644 /etc/nginx/conf.d/default.conf \
 && find /usr/share/nginx/html -type d -exec chmod 0755 {} + \
 && find /usr/share/nginx/html -type f -exec chmod 0644 {} +
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
