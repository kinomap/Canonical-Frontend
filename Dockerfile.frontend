# Stage 1: Build Public Frontend
FROM node:20-alpine AS public-builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci || npm install
COPY frontend/ ./
RUN npm run build

# Stage 2: Build Admin Frontend
FROM node:20-alpine AS admin-builder
WORKDIR /app
COPY admin-frontend/package*.json ./
RUN npm ci || npm install
COPY admin-frontend/ ./
RUN npm run build

# Stage 3: Serve both with Nginx
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=public-builder /app/dist /usr/share/nginx/html/public
COPY --from=admin-builder /app/dist /usr/share/nginx/html/admin
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
